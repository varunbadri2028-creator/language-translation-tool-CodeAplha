# ====================================
# LinguaTranslate Server Configuration
# ====================================

# Server
PORT=5000
NODE_ENV=development

# CORS - Frontend URL (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Translation API Provider: "mymemory" | "libretranslate" | "google"
TRANSLATION_PROVIDER=mymemory

# LibreTranslate (if using LibreTranslate provider)
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# Google Translate (if using Google provider)
GOOGLE_TRANSLATE_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
